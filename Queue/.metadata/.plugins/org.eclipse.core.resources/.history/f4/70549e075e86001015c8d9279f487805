import java.awt.Frame;

import javax.security.auth.callback.ConfirmationCallback;

public class QueueArray<E> 
{
	private E[] data;
	private int font;
	private int rear;
	private static final  int queueSize=100;
	
	public QueueArray(int size)
	{
		data=(E[])new Object[size];
		font=-1;
		rear=-1;
	}
	public QueueArray()
	{
		this(queueSize);
	}
	public boolean isEmpty()
	{
		return font==-1;
	}
	public boolean isFull()
	{
		return rear==data.length;
	}
	public void enqueue(E element)
	{
		if(isFull())
		{
			System.out.println("Queue is Full");
			return;
		}
		if(font==-1)
			font=0;
		data[++rear]=element;

	}
	public E dequeue()
	{
		if(isEmpty())
		{
			System.out.println("Queue is empty.");
			return null;
		}
		E fisrt=data[0];
		data[font]=null;
		int h=size();
		for(int i=0;i<h-1;i++)
		{
			h--;
			data[i]=data[i+1];
		}
		return fisrt;
	}	
		
	public int size()
	{
		int count=0;
		if(isEmpty())
			return count;
		for(int i=font;i<=rear;i++)
		{
			count++;
		}
		return count;
	
	}
	public void display()
	{
		if(font==-1)
		{
			System.out.println("Queue is empty.");
			return;
		}
		for(int i=font;i<=rear;i++)
		{
			System.out.println(data[i]);
		}
	}
}
